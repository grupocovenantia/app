{
  "name": "Covenantia RM",
  "short_name": "Covenantia RM",
  "description": "Motor financiero para concesiones de transporte: costo por km, tarifa requerida, resultados y evaluación.",
  "lang": "es-MX",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#14213d",
  "theme_color": "#14213d",
  "file_handlers": [
    { "action": "./", "accept": { "application/x-covenantia-rm": [".crm"] },
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }], "launch_type": "single-client" }
  ],
  "launch_handler": { "client_mode": "focus-existing" },
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
